{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile",
      "type": "shell",
      "command": "mvn -q -DskipTests compile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$maven"]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "mvn -q test",
      "group": "test",
      "problemMatcher": ["$maven"]
    }
  ]
}
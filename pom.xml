<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build for TikTokSignatrueForJava.

  The library itself has zero runtime dependencies; JUnit is a
  test-scoped dependency only, used so `mvn test` can run the suite
  with the standard Maven/Surefire toolchain.

  Author: S1 (github.com/JokerPython3)
  Language: Java
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.jokerpython3</groupId>
  <artifactId>tiktoksignature-java</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>TikTokSignatrueForJava</name>
  <description>
    Java port of the TikTok signing pipeline (X-Argus, X-Ladon, X-Gorgon,
    X-Khronos, X-TT-Request-Ticket, X-SS-Stub). Behavior is verified
    byte-for-byte against the Go reference and the Python SignerPy project.
  </description>

  <url>https://github.com/JokerPython3</url>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <dependencies>
    <!-- Test-only dependency; the runtime library depends only on the JDK. -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>